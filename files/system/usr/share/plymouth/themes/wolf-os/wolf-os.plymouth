[Plymouth Theme]
Name=Wolf OS
Description=Wolf OS boot screen: the wolf emblem above the disk password box and a small spinner.
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/wolf-os
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.7
HorizontalAlignment=.5
VerticalAlignment=.84
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.38
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0e1726
BackgroundEndColor=0x05080f
ProgressBarBackgroundColor=0x1f2835
ProgressBarForegroundColor=0x33b5f0
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
